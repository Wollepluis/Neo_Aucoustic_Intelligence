<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:id="Background" prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #1D1D1D;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.neo_aucoustic_intelligence.LoginSchermController">
    <children>
        <TextField fx:id="gebruikersNaamInput" layoutX="200.0" layoutY="227.0" prefHeight="26.0" prefWidth="412.0" promptText="Vul hier uw gebruikersnaam in" stylesheets="@style.css" />
        <PasswordField fx:id="wachtwoordInput" layoutX="200.0" layoutY="273.0" prefHeight="26.0" prefWidth="412.0" promptText="Vul hier uw gebruikersnaam in" />
        <Button fx:id="loginButton" layoutX="358.0" layoutY="313.0" minHeight="-Infinity" mnemonicParsing="false" onAction="#naarMain" prefHeight="20.0" prefWidth="64.0" style="-fx-font-size: 10; -fx-background-color: #383838; -fx-font-style: #383838;" text="Login" textFill="WHITE" />
      <TextField fx:id="errorText" disable="true" layoutX="267.0" layoutY="342.0" opacity="0.0" prefHeight="26.0" prefWidth="246.0" style="-fx-font-size: 10; -fx-text-fill: red; -fx-background-color: #1D1D1D;" text="Gebruikersnaam en wachtwoord komen niet overeen" />
      <TextField fx:id="titelText" layoutX="173.0" layoutY="135.0" prefHeight="86.0" prefWidth="434.0" style="-fx-font-size: 40; -fx-background-color: #1D1D1D; -fx-text-fill: white;" text="Aucoustic Intelligence" />
    </children>
</AnchorPane>
